{
	"minimap": {
		"show": "auto"
	},
	"base_keymap": "VSCode",
	"soft_wrap": "bounded",
	"terminal": {
		"font_size": 16.0,
		"dock": "bottom",
		"shell": {
			"program": "/nix/store/x6qcc23lrc64g0vjp9pfsa9scpy1mnpk-fish-4.9.3/bin/fish"
		}
	},
	"hard_tabs": true,
	"tab_size": 2,
	"icon_theme": "VSCode Icons for Zed (Dark)",
	"disable_ai": true,
	"vim_mode": false,
	"toolbar": {
		"quick_actions": false,
		"breadcrumbs": false
	},
	"cli_default_open_behavior": "existing_window",
	"git_panel": {
		"dock": "left"
	},
	"project_panel": {
		"hide_gitignore": true,
		"hide_hidden": true,
		"dock": "left",
		"auto_fold_dirs": false
	},
	"ui_font_family": "Adwaita Sans",
	"ui_font_size": 15.6,
	"buffer_font_size": 15.8,
	"buffer_font_weight": 395,
	"buffer_font_family": "JetBrains Mono",
	"theme": "Rosé Pine",
	"format_on_save": "on",
	"lsp_document_colors": "inlay",
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"unusedDisableDirectives": "deny",
					"typeAware": true
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		},
		"nix": {
			"binary": {
				"path_lookup": true
			}
		},
		"nixd": {
			"binary": {
				"path": "/nix/store/va72pzxzj53807h9hqpyhwiv2a0l4a27-nixd-2.9.3/bin/nixd"
			},
			"settings": {
				"diagnostic": {
					"suppress": [
						"sema-extra-with"
					]
				},
				"formatting": {
					"command": [
						"nixfmt"
					]
				},
				"nixpkgs": {
					"expr": "import (builtins.getFlake \"/home/zeamanuel/Code/config/nixos-flake-parts\").inputs.nixpkgs { }"
				},
				"options": {
					"flake-parts": {
						"expr": "(builtins.getFlake \"/home/zeamanuel/Code/config/nixos-flake-parts\").debug.options"
					},
					"home-manager": {
						"expr": "(builtins.getFlake \"/home/zeamanuel/Code/config/nixos-flake-parts\").homeConfigurations.zeamanuel.options"
					},
					"nixos": {
						"expr": "(builtins.getFlake \"/home/zeamanuel/Code/config/nixos-flake-parts\").nixosConfigurations.zeamanuelMachine.options"
					}
				}
			}
		},
		"clangd": {
			"binary": {
				"path": "/nix/store/cipb905rmw1ha3c3kbyy8kiyynr0w5nr-ccls-0.20250815.1/bin/ccls",
				"arguments": []
			}
		},
		"vtsls": {
			"enable_lsp_tasks": true,
		}
	},
	"languages": {
		"QML": {
			"tab_size": 2,
			"auto_indent": "syntax_aware",
			"format_on_save": "on"
		},
		"TypeScript": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": [
				"tsgo",
				"!vtsls",
				"!eslint",
				"!typescript-language-server",
				"..."
			]
		},
		"Kdl": {
			"formatter": "language_server"
		},
		"TSX": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": [
				"tsgo",
				"!vtsls",
				"!eslint",
				"!typescript-language-server",
				"..."
			]
		},
		"CSS": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JavaScript": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"Rust": {
			"hard_tabs": true,
			"tab_size": 2
		}
	},
	"auto_install_extensions": {
		"emmet": true,
		"nix": true,
		"oxc": true,
		"tailwindcss": true,
		"vscode-icons": true,
		"vue": true
	},
	"autoscroll_on_clicks": true,
	"buffer_line_height": "comfortable",
	"diff_view_style": "split",
	"edit_predictions": {
		"provider": "none"
	},
	"file_types": {
		"Git Config": [
			"conf"
		]
	},
	"formatter": "language_server",
	"preferred_line_length": 110,
	"session": {
		"trust_all_worktrees": true
	},
	"show_edit_predictions": false,
	"show_wrap_guides": true,
	"telemetry": {
		"metrics": false
	},
	"ui_font_weight": 300
}
