{
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.disableAIFeatures": true,
  "explorer.excludeGitIgnore": true, 
  "sqltools.connectionExplorer.groupConnected": true,
  "sqltools.results.reuseTabs": "connection",
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontFamily": "jetbrains mono",
  "terminal.integrated.fontSize": 15.5,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "oxc.enable.oxfmt": true,
  "oxc.fixKind": "safe_fix_or_suggestion",
  "oxc.unusedDisableDirectives": "warn",
  "oxc.typeAware": true,
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "nix.enableLanguageServer": true,
  "nix.formatterPath": "nixfmt",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import <nixpkgs> { }"
      },
      "formatting": {
        "command": [
          "nixfmt"
        ]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake (builtins.toString \"/etc/nixos\")).nixosConfigurations.<name>.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake (builtins.toString \"/etc/nixos\")).nixosConfigurations.zeaman.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
